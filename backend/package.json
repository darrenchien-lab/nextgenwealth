{
  "name": "nextgen-wealth-api",
  "version": "0.1.0",
  "private": true,
  "description": "NextGen Wealth personal finance management API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "setup-db": "node scripts/setup-db.js",
    "seed-demo": "node scripts/seed-demo.js",
