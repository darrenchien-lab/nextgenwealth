PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/financeflow
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1h
BILL_REMINDER_WINDOW_DAYS=7
EXCHANGE_RATE_STALENESS_ALERT_DAYS=3
FRONTEND_URL=http://localhost:3001
GMAIL_USER=
GMAIL_APP_PASSWORD=

# AI features (Quick add, Help chat, Insights summary) run on a local Ollama
# server, so nothing leaves your machine. Install Ollama, then: ollama pull llama3.1:8b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# OLLAMA_TIMEOUT_MS=120000
# OLLAMA_CHECK_MS=3000

# Going public
# The website allowed to call this API from a browser (extra ones: CORS_ORIGINS=https://a.com,https://b.com).
# FRONTEND_URL above is used for this, so set it to your real https address in production.
# How many proxies sit in front of the API (1 behind Caddy/Nginx/Cloudflare, leave empty if none).
# TRUST_PROXY=1

# Safety: the app refuses to start against the wrong database (see db/dbGuard.js).
# On the live server set NODE_ENV=production, and name its database so that it contains "prod" (e.g. financeflow_prod).
# NODE_ENV=production
# ALLOW_REMOTE_DB=1     only for a staging run that talks to a database on another computer
# ALLOW_ANY_DB_NAME=1   only if a production database really cannot have "prod" in its name

# Login secret: in production it must be at least 32 random characters, or the server refuses to start.
# Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
